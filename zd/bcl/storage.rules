rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == "admin" && request.auth.token.active == true; }
    function zmart() { return signedIn() && request.auth.token.role == "zmart" && request.auth.token.active == true; }

    match /users/{uid}/deliveries/{deliveryId}/{fileName} {
      allow read: if admin() || (zmart() && request.auth.uid == uid);
      allow write: if zmart() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if admin() || (zmart() && request.auth.uid == uid);
    }
  }
}
