rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function active() { return signedIn() && request.auth.token.active == true; }
    function admin() { return active() && role() == "admin"; }
    function zmart() { return active() && role() == "zmart"; }

    // USERS Google Sheet adalah master identitas/role. Collection users tidak lagi dipakai.
    match /users/{uid} {
      allow read, write: if false;
    }

    match /bcl/{id} {
      allow read: if admin() || zmart();
      allow create, update, delete: if admin();
    }

    match /assignments/{id} {
      allow read: if admin() || (zmart() && resource.data.zmartUid == request.auth.uid);
      allow create, delete: if admin();
      allow update: if admin() || (zmart() && resource.data.zmartUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","completedAt"]));
    }

    match /deliveries/{id} {
      allow read: if admin() || (zmart() && resource.data.zmartUid == request.auth.uid);
      allow create: if zmart() && request.resource.data.zmartUid == request.auth.uid;
      allow update, delete: if admin();
    }
  }
}
